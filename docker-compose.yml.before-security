
services:
  web:
    build:
      context: .
      dockerfile: Dockerfile

    image: instagram-clone:local
    container_name: instagram-clone-app

    env_file:
      - .env

    ports:
      - "8000:8000"

    volumes:
      - ./db.sqlite3:/app/db.sqlite3
      - ./media:/app/media

    restart: unless-stopped

    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/auth/login/', timeout=3)"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
